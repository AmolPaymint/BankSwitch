{
  "Repository": {
    "Provider": "InMemory"
  },
  "ConnectionStrings": {
    "SwitchDb": "Server=tcp:sql.example.internal,1433;Database=SwitchDB;User ID=switch_app;Password=${VAULT:SwitchDbPassword};Encrypt=True;TrustServerCertificate=False;Application Name=BankSwitch.Engine"
  },
  "Database": {
    "MinPoolSize": 10,
    "MaxPoolSize": 200,
    "ConnectionTimeoutSeconds": 5,
    "CommandTimeoutSeconds": 30,
    "SlowConnectionThresholdMs": 100
  },
  "Redis": {
    "ConnectionString": "",
    "KeyPrefix": "bankswitch:",
    "DefaultTtlMinutes": 5
  },
  "Secrets": {
    "PanLookupHmacKey": "development-only-change-me",
    "CardDataEncryptionKey": "MDEyMzQ1Njc4OUFCQ0RFRjAxMjM0NTY3ODlBQkNERUY=",
    "SoftwareMacKey": "development-only-software-mac-key"
  },
  "SensitiveData": {
    "Mode": "Development"
  },
  "SourceGateway": {
    "Enabled": true,
    "ListenIp": "0.0.0.0",
    "Port": 5050,
    "DefaultSourceNodeId": "SRC-DEV-001",
    "RequireMutualTls": false,
    "ServerCertificatePath": "",
    "ServerCertificatePasswordSecretName": "SourceGatewayServerCertificatePassword",
    "HeaderBytes": 2,
    "MaxConcurrentConnections": 512,
    "ReplayTtlSeconds": 300
  },
  "Hsm": {
    "Mode": "BypassForDevelopmentOnly",
    "BaseUrl": "https://hsm-gateway.example.internal/api/hsm"
  },
  "Sink": {
    "BypassForDevelopmentOnly": true,
    "UseTls": false,
    "ClientCertificatePath": "",
    "ClientCertificatePasswordSecretName": "SinkClientCertificatePassword",
    "HeaderBytes": 2,
    "TimeoutSeconds": 60,
    "AllowInvalidServerCertificateForDevelopmentOnly": false
  },
  "CircuitBreaker": {
    "FailuresBeforeOpen": 3,
    "OpenSeconds": 30
  },
  "StandIn": {
    "Enabled": false,
    "StuckTransactionThresholdSeconds": 120,
    "RecoveryWorkerIntervalSeconds": 60,
    "GlobalFloorLimitAmount": 10000.00,
    "GlobalFloorLimitCurrency": "566"
  },
  "Reversal": {
    "MaxAttempts": 5,
    "WorkerIntervalSeconds": 30
  },
  "Serilog": {
    "MinimumLevel": "Information"
  },
  "CmsAuthorization": {
    "Enabled": true,
    "ForwardApprovedTransactionsToSink": false,
    "PrepaidTransactionTypes": [
      "00",
      "20"
    ]
  },
  "CmsSeed": {
    "Pan": "5399838383838381"
  },
  "EnterpriseProduction": {
    "Enabled": true,
    "OutboxDispatcherEnabled": true,
    "OutboxDispatchIntervalSeconds": 15,
    "OutboxBatchSize": 100,
    "RequireThreeDsForCardNotPresent": true,
    "ThreeDsRequiredChannels": [
      "02",
      "ECOM",
      "WEB"
    ],
    "ThreeDsExpiryMinutes": 10,
    "ThreeDsChallengeAmountThreshold": 100000,
    "FraudAlertScoreThreshold": 60,
    "FraudDeclineScoreThreshold": 85,
    "VelocityEventCountThreshold": 5,
    "VelocityWindowMinutes": 10,
    "DataWarehouseOutputRoot": "./warehouse-exports",
    "ClusterHeartbeatTtlSeconds": 90,
    "HeartbeatIntervalSeconds": 30,
    "WarehouseWorkerIntervalSeconds": 300,
    "SiemWorkerIntervalSeconds": 15
  },
  "ThreeDS": {
    "Mode": "BypassForDevelopmentOnly",
    "BaseUrl": "",
    "RequiredChannels": [
      "02",
      "EC",
      "ECOM"
    ],
    "RequireWhenAuthenticationDataMissing": false
  },
  "AmlSanctions": {
    "Mode": "BypassForDevelopmentOnly",
    "BaseUrl": "",
    "BlockedNameFragments": [
      "SANCTIONED TEST"
    ]
  },
  "Fraud": {
    "HighAmountThreshold": 500000,
    "BlockAmountThreshold": 5000000,
    "BlockedCountries": [
      "IR",
      "KP",
      "SY"
    ],
    "HighRiskCustomerRatings": [
      "HIGH"
    ]
  },
  "DataWarehouse": {
    "Mode": "LogOnly",
    "BaseUrl": ""
  },
  "Siem": {
    "Mode": "LogOnly",
    "BaseUrl": ""
  },
  "HighAvailability": {
    "HeartbeatEnabled": true,
    "HeartbeatIntervalSeconds": 10,
    "HealthProbeEnabled": true,
    "HealthProbePort": 5051,
    "NodeId": "bankswitch-node-01",
    "InstanceId": "${HOSTNAME}",
    "Region": "primary",
    "Role": "engine",
    "Draining": false
  },
  "DisasterRecovery": {
    "CheckpointWorkerEnabled": true,
    "CheckpointIntervalMinutes": 15,
    "CheckpointType": "PRIMARY",
    "Region": "primary",
    "RpoSeconds": 300,
    "RtoSeconds": 1800,
    "ReplicationLagSeconds": 0,
    "LastBackupAgeMinutes": 10,
    "LastRestoreTestAgeDays": 30
  },
  "RegulatoryReporting": {
    "DefaultJurisdiction": "LOCAL",
    "SuspiciousActivityThreshold": 1000000
  }
