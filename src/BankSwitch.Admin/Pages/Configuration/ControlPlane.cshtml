@page
@model BankSwitch.Admin.Pages.Configuration.ControlPlaneModel
@{
    ViewData["Title"] = "Enterprise Configuration Control Plane";
}
<style>
.cp{font-family:system-ui,-apple-system,Segoe UI,sans-serif;background:#0b1020;color:#dbe7ff;min-height:100vh;padding:24px}.cp h1{margin:0 0 4px;font-size:28px}.cp .sub{color:#8293b7;margin-bottom:20px}.toolbar,.grid{display:grid;gap:12px}.toolbar{grid-template-columns:160px 220px 1fr auto;margin-bottom:16px}.grid{grid-template-columns:260px 1fr 360px}.panel{background:#111a30;border:1px solid #223252;border-radius:12px;padding:16px}.panel h3{margin:0 0 12px}.domains button{display:block;width:100%;text-align:left;padding:9px 10px;margin:4px 0;background:#0e1629;color:#aebddd;border:1px solid #1d2c49;border-radius:7px;cursor:pointer}.domains button.active{background:#17315d;color:#fff;border-color:#3977d8}.setting{padding:12px;border-bottom:1px solid #1d2c49}.setting:last-child{border:0}.setting .k{font-weight:700}.setting .d{font-size:12px;color:#788aaa}.setting input,.setting select,textarea{width:100%;margin-top:7px;padding:8px;background:#09111f;color:#dbe7ff;border:1px solid #2c4068;border-radius:6px}.meta{display:flex;gap:6px;margin-top:6px;flex-wrap:wrap}.tag{font-size:10px;padding:2px 6px;border-radius:10px;background:#1c2943;color:#91a7d2}.tag.critical{background:#4b1c29;color:#ff9aad}.tag.secret{background:#34224f;color:#c7a6ff}.btn{padding:9px 14px;border:0;border-radius:7px;background:#3478e5;color:#fff;font-weight:700;cursor:pointer}.btn.secondary{background:#243553}.btn.danger{background:#a23445}.status{font-size:12px;color:#8fa0c2;}.req{padding:10px;border:1px solid #233557;border-radius:8px;margin:8px 0;}.req strong{display:block;}.ok{color:#34d399}.warn{color:#fbbf24}.err{color:#fb7185}@@media(max-width:1100px){.grid{grid-template-columns:1fr}.toolbar{grid-template-columns:1fr 1fr}.toolbar .grow{grid-column:1/-1}}
</style>
<div class="cp">
  <h1>Enterprise Configuration Control Plane</h1>
  <div class="sub">v44.1 · Versioned configuration · Maker-checker · Snapshots · Audit · Runtime diagnostics</div>
  <div class="toolbar">
    <select id="env"><option>DEV</option><option>SIT</option><option>UAT</option><option>PREPROD</option><option>PROD</option><option>DR</option></select>
    <input id="scope" value="DEFAULT" placeholder="Institution scope" />
    <input class="grow" id="search" placeholder="Search settings..." />
    <button class="btn secondary" onclick="loadAll()">Refresh</button>
  </div>
  <div class="grid">
    <div class="panel"><h3>Domains</h3><div class="domains" id="domains"></div></div>
    <div class="panel"><h3 id="domainTitle">Settings</h3><div id="settings"></div><div style="margin-top:16px"><button class="btn" onclick="draftChange()">Create Change Request</button></div></div>
    <div class="panel"><h3>Control Plane</h3><div id="diag" class="status">Loading diagnostics…</div><hr style="border-color:#223252"><h3>Pending Changes</h3><div id="changes"></div><hr style="border-color:#223252"><button class="btn secondary" onclick="createSnapshot()">Create Snapshot</button></div>
  </div>
</div>
<script>
const state={domains:[],defs:[],values:new Map(),domain:null,dirty:new Map()};
const $=id=>document.getElementById(id); const env=()=>$('env').value; const scope=()=>$('scope').value||'DEFAULT';
async function api(url,opt){const r=await fetch(url,opt);if(!r.ok)throw new Error(await r.text());return r.status===204?null:r.json();}
async function loadAll(){await Promise.all([loadDomains(),loadDiagnostics(),loadChanges()]); if(state.domain) await loadDomain(state.domain);}
async function loadDomains(){state.domains=await api('/api/settings/domains');$('domains').innerHTML=state.domains.map(d=>`<button onclick="loadDomain('${d.code}')" class="${state.domain===d.code?'active':''}">${d.name}</button>`).join('');if(!state.domain&&state.domains.length)loadDomain(state.domains[0].code);}
async function loadDomain(code){state.domain=code;state.dirty.clear();state.defs=await api('/api/settings/definitions?domain='+encodeURIComponent(code));const vals=await api(`/api/settings/values?environment=${encodeURIComponent(env())}&institutionScope=${encodeURIComponent(scope())}&domain=${encodeURIComponent(code)}`);state.values=new Map(vals.map(v=>[v.definitionId,v]));$('domainTitle').textContent=state.domains.find(x=>x.code===code)?.name||code;renderSettings();loadDomains();}
function renderSettings(){const q=$('search').value.toLowerCase();$('settings').innerHTML=state.defs.filter(d=>(d.displayName+' '+d.key+' '+d.description).toLowerCase().includes(q)).map(d=>{const v=state.values.get(d.id);const value=v?.value??d.defaultValue??'';const input=d.valueType==='Boolean'?`<select data-id="${d.id}" onchange="edit('${d.id}',this.value)"><option ${value==='true'?'selected':''}>true</option><option ${value==='false'?'selected':''}>false</option></select>`:`<input data-id="${d.id}" value="${esc(value)}" onchange="edit('${d.id}',this.value)" ${d.isSecret?'placeholder="secret reference only"':''}/>`;return `<div class="setting"><div class="k">${esc(d.displayName)} <span class="status">${esc(d.key)}</span></div><div class="d">${esc(d.description)}</div>${input}<div class="meta"><span class="tag ${d.sensitivity==='Critical'?'critical':''}">${d.sensitivity}</span><span class="tag">${d.reloadPolicy}</span>${d.requiresApproval?'<span class="tag critical">approval</span>':''}${d.isSecret?'<span class="tag secret">secret-ref</span>':''}</div></div>`}).join('');}
function edit(id,val){const d=state.defs.find(x=>x.id===id);if(d)state.dirty.set(id,{domainCode:d.domainCode,key:d.key,newValue:val});}
async function draftChange(){if(!state.dirty.size){alert('No setting changes selected.');return;}const reason=prompt('Reason for change:');if(!reason)return;const ticket=prompt('Ticket/reference:','CHG-');if(!ticket)return;const body={environment:env(),institutionScope:scope(),reason,ticketReference:ticket,effectiveAt:null,items:[...state.dirty.values()]};const validation=await api('/api/settings/validate',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});if(!validation.isValid){alert(validation.issues.map(x=>x.message).join('\n'));return;}await api('/api/settings/change-requests',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});state.dirty.clear();await loadChanges();alert('Draft change request created.');}
async function loadChanges(){try{const items=await api('/api/settings/change-requests');$('changes').innerHTML=items.slice(0,12).map(c=>`<div class="req"><strong>${c.state} · ${c.environment}</strong><span class="status">${esc(c.ticketReference)} · ${c.items.length} item(s)</span><div style="margin-top:6px">${c.state==='Draft'?`<button class="btn secondary" onclick="act('${c.id}','submit')">Submit</button>`:''}${c.state==='Submitted'?` <button class="btn" onclick="act('${c.id}','approve')">Approve</button>`:''}${c.state==='Approved'?` <button class="btn" onclick="act('${c.id}','apply')">Apply</button>`:''}</div></div>`).join('')||'<span class="status">No changes.</span>';}catch(e){$('changes').innerHTML='<span class="err">'+esc(e.message)+'</span>';}}
async function act(id,a){await api(`/api/settings/change-requests/${id}/${a}`,{method:'POST',headers:{'Content-Type':'application/json'}});await loadChanges();if(a==='apply')await loadDomain(state.domain);}
async function loadDiagnostics(){try{const d=await api('/api/settings/diagnostics');$('diag').innerHTML=d.map(x=>`<div><span class="${x.status==='Healthy'?'ok':x.status==='Warning'?'warn':'err'}">●</span> ${esc(x.component)} — ${esc(x.status)} ${x.latencyMs?`(${Math.round(x.latencyMs)}ms)`:''}</div>`).join('');}catch(e){$('diag').innerHTML='<span class="err">'+esc(e.message)+'</span>';}}
async function createSnapshot(){const name=prompt('Snapshot name:','pre-change-'+new Date().toISOString());if(!name)return;await api('/api/settings/snapshots',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name,environment:env(),institutionScope:scope()})});alert('Snapshot created.');}
function esc(v){return String(v??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));}
$('search').addEventListener('input',renderSettings);$('env').addEventListener('change',()=>state.domain&&loadDomain(state.domain));$('scope').addEventListener('change',()=>state.domain&&loadDomain(state.domain));loadAll();
</script>
