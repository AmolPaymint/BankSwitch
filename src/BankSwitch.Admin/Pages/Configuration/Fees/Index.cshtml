@page
@model BankSwitch.Admin.Pages.Configuration.Fees.IndexModel
<h1>Fees</h1>
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <p class="danger">@Model.ErrorMessage</p>
}
<table>
    <thead><tr><th>Name</th><th>Flat amount</th><th>Percentage %</th><th>Minimum</th><th>Maximum</th><th>Active</th><th></th></tr></thead>
    <tbody>
    @foreach (var fee in Model.Fees)
    {
        <tr>
            <form method="post" asp-page-handler="Update">
                <input type="hidden" name="id" value="@fee.Id" />
                <td><input name="Input.Name" value="@fee.Name" /></td>
                <td><input name="Input.FlatAmount" value="@fee.FlatAmount" type="number" step="0.01" /></td>
                <td><input name="Input.PercentageOfTransaction" value="@fee.PercentageOfTransaction" type="number" step="0.0001" /></td>
                <td><input name="Input.Minimum" value="@fee.Minimum" type="number" step="0.01" /></td>
                <td><input name="Input.Maximum" value="@fee.Maximum" type="number" step="0.01" /></td>
                <td><input type="checkbox" name="Input.IsActive" value="true" style="width:auto" checked="@fee.IsActive" /></td>
                <td><button type="submit">Save</button></td>
            </form>
        </tr>
    }
    </tbody>
</table>

<h2>Add new fee</h2>
<form method="post" asp-page-handler="Create">
    <div><label asp-for="Input.Name"></label><input asp-for="Input.Name" /></div>
    <div><label asp-for="Input.FlatAmount"></label><input asp-for="Input.FlatAmount" type="number" step="0.01" /></div>
    <div><label asp-for="Input.PercentageOfTransaction">Percentage of transaction (%)</label><input asp-for="Input.PercentageOfTransaction" type="number" step="0.0001" /></div>
    <div><label asp-for="Input.Minimum"></label><input asp-for="Input.Minimum" type="number" step="0.01" /></div>
    <div><label asp-for="Input.Maximum"></label><input asp-for="Input.Maximum" type="number" step="0.01" /></div>
    <div><label asp-for="Input.IsActive"></label><input asp-for="Input.IsActive" type="checkbox" style="width:auto" /></div>
    <button type="submit">Add fee</button>
</form>
