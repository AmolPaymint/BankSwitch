# ─────────────────────────────────────────────
# Stage 1 — Build
# ─────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

COPY ["src/BankSwitch.Domain/BankSwitch.Domain.csproj",            "src/BankSwitch.Domain/"]
COPY ["src/BankSwitch.Application/BankSwitch.Application.csproj",  "src/BankSwitch.Application/"]
COPY ["src/BankSwitch.Infrastructure/BankSwitch.Infrastructure.csproj", "src/BankSwitch.Infrastructure/"]
COPY ["src/BankSwitch.Admin/BankSwitch.Admin.csproj",              "src/BankSwitch.Admin/"]
COPY ["src/BankSwitch.Core/BankSwitch.Core.csproj",    "src/BankSwitch.Core/"]
COPY ["src/BankSwitch.DAO/BankSwitch.DAO.csproj",      "src/BankSwitch.DAO/"]
COPY ["src/BankSwitch.Logic/BankSwitch.Logic.csproj",  "src/BankSwitch.Logic/"]
COPY ["src/BankSwitch.Mapping/BankSwitch.Mapping.csproj", "src/BankSwitch.Mapping/"]

RUN dotnet restore "src/BankSwitch.Admin/BankSwitch.Admin.csproj"

COPY . .
RUN dotnet publish "src/BankSwitch.Admin/BankSwitch.Admin.csproj" \
    -c Release \
    -o /app/publish \
    --no-restore \
    /p:UseAppHost=false

# ─────────────────────────────────────────────
# Stage 2 — Runtime
# ─────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
WORKDIR /app

RUN groupadd --gid 1001 bankswitch \
 && useradd  --uid 1001 --gid bankswitch --shell /bin/sh --no-create-home bankswitch \
 && mkdir -p /app/logs \
 && chown -R bankswitch:bankswitch /app

COPY --from=build --chown=bankswitch:bankswitch /app/publish .

# Admin portal listens on 8081 (HTTP) and optionally 8443 (HTTPS via Ingress TLS termination)
EXPOSE 8081

USER bankswitch

HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8081/health/live || exit 1

ENV ASPNETCORE_ENVIRONMENT=Production \
    ASPNETCORE_URLS=http://+:8081 \
    DOTNET_RUNNING_IN_CONTAINER=true \
    DOTNET_GCConserveMemory=1

ENTRYPOINT ["dotnet", "BankSwitch.Admin.dll"]
